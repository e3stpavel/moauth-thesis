---
import { actions, isInputError } from 'astro:actions'
import Logo from '~/assets/logo-no-space.svg'
import Banner from '~/components/ui/Banner.astro'
import Button from '~/components/ui/Button.astro'
import TextInput from '~/components/ui/TextInput.astro'
import AuthLayout from '~/layouts/AuthLayout.astro'
import { redirectUriSchema } from '~/auth/models'
import { validateRequestParameter } from '~/oauth/parameters'
import { formUrlEncoded } from '@moauth/encoding'

const query = Astro.url.searchParams
let [_, redirectUri] = validateRequestParameter('redirect_uri', query, redirectUriSchema)
if (!redirectUri) {
  redirectUri = '/'
}

// Astro makes POST request to `?_action=auth.login`, therefore it removes `redirect_uri` from original request
const actionQueryString = actions.auth.login.queryString + `&redirect_uri=${formUrlEncoded.encode(redirectUri)}`

const result = Astro.getActionResult(actions.auth.login)
const formErrors = isInputError(result?.error) ? result.error.fields : {}
if (result && !result.error) {
  return Astro.redirect(redirectUri, 303)
}

// if user was logged in (has active session), it will redirect him anyways, even with errors from action
if (Astro.locals.session) {
  return Astro.redirect(redirectUri)
}

Astro.response.headers.set('cache-control', 'no-store')
Astro.response.headers.set('referrer-policy', 'strict-origin')
---

<AuthLayout>
  <div class="bg-white">
    <section class="@container mx-auto max-w-md px-4 py-8 sm:px-8">
      <div class="">
        <Logo class="h-7 w-auto text-gray-900" />
        <h1 class="mt-6 text-xl font-semibold tracking-tight text-gray-900">Good to see you again</h1>
        <p class="mt-3 text-sm text-gray-600">Sign in to access your mlla account</p>
        <form method="POST" action={actionQueryString} class="space-y-6 py-6">
          <TextInput
            type="email"
            label="Email"
            id="email"
            name="email"
            autocomplete="email"
            required
            errors={formErrors.email}
          />
          {/* TODO: forgot password? */}
          <TextInput
            type="password"
            label="Password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            errors={formErrors.password}
          />
          <p class="mt-3 text-sm text-gray-600">
            By proceeding, you acknowledge and agree to our
            <a href="#" target="_blank" class="text-blue-700 hover:text-blue-500 hover:underline"> Terms of Service </a>
            and
            <a href="#" target="_blank" class="text-blue-700 hover:text-blue-500 hover:underline"> Privacy Policy </a>
          </p>
          {result?.error && !isInputError(result.error) && <Banner message={result.error.message} variant="error" />}
          <div class="grid grid-cols-1">
            <Button type="submit">Sign in</Button>
          </div>
          <p class="text-center text-sm text-gray-600">
            Don't have an account?
            <a href="#" class="text-blue-700 hover:text-blue-500 hover:underline">Create one</a>
          </p>
        </form>
      </div>
    </section>
  </div>
</AuthLayout>
