---
import { Code } from 'astro:components'
import Logo from '~/assets/logo-no-space.svg'
import AuthLayout from '~/layouts/AuthLayout.astro'
import { authorize } from '~/oauth/routes'

const response = await authorize(Astro)
if (response.status === 302 || response.status === 303) {
  return response
}

const error = await response.json()

Astro.response.status = response.status
Astro.response.headers.set('cache-control', 'no-store')
---

<AuthLayout>
  <div class="bg-white">
    <section class="@container mx-auto max-w-md px-4 py-8 sm:px-8">
      <div class="">
        <Logo class="h-7 w-auto text-gray-900" />
        <h1 class="mt-6 text-xl font-semibold tracking-tight text-gray-900">
          We won't be proceeding with this request
        </h1>
        <p class="mt-3 text-sm text-gray-600">
          This request cannot be completed because it appears to be invalid or potentially unsafe. It may be caused by a
          configuration issue, or it could indicate a malicious attempt to access your account
        </p>
        <p class="mt-3 text-sm text-gray-600">
          If the application you were using is unfamiliar or unexpected,
          <span class="bg-gray-900 box-decoration-clone font-bold text-white">don't continue!</span>
          It's safest to close this page
        </p>
        <p class="mt-3 text-sm text-gray-900">
          <a href="#" class="text-blue-700 hover:text-blue-500 hover:underline">Learn why it happens</a>
        </p>
        <hr class="my-6 text-gray-300" />
        <p class="text-sm text-gray-600">Troubleshooting details:</p>
        <Code
          class="mt-1 rounded-md border border-gray-400/40 bg-gray-100! text-sm select-all"
          code={JSON.stringify(error, null, 2)}
          lang="json"
          wrap={false}
          theme="github-light-default"
        />
        <!-- <dl class="mt-3 space-y-3">
          <div class="grid grid-cols-1 gap-2 @sm:grid-cols-2">
            <dt class="text-sm text-gray-600">Error</dt>
            <dd class="text-sm text-gray-600 @sm:text-right">
              <code class="inline-block rounded bg-gray-100 box-decoration-clone px-1 text-gray-700">
                {error.code}
              </code>
            </dd>
          </div>
          <div class="grid grid-cols-1 gap-2 @sm:grid-cols-2">
            <dt class="text-sm text-gray-600">Error description</dt>
            <dd class="text-sm text-gray-900 @sm:text-right">
              <code>{error.message}</code>
            </dd>
          </div>
        </dl> -->
      </div>
    </section>
  </div>
</AuthLayout>
