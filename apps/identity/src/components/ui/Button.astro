---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'button'> {
  variant?: 'primary' | 'secondary'
  size?: 'sm' | 'md' | 'lg'
}

const { variant = 'primary', size = 'md', ...attrs } = Astro.props
---

<button
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md border text-sm font-semibold shadow-xs focus-visible:ring-4 focus-visible:ring-white focus-visible:outline-blue-700 focus-visible:ring-inset',
    {
      'h-7 px-2': size === 'sm',
      'h-8 px-3': size === 'md',
      'h-10 px-4': size === 'lg',
    },
    {
      'border-green-900/40 bg-green-800 text-white hover:bg-green-700 active:bg-green-900': variant === 'primary',
      'border-gray-400/40 bg-gray-100 text-gray-950 hover:bg-gray-50 active:bg-gray-200': variant === 'secondary',
    },
  ]}
  {...attrs}
>
  <slot />
</button>
