---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Logo from '~/assets/logo-no-space.svg'
---

<BaseLayout>
  <main class="bg-white">
    <section class="@container mx-auto max-w-md px-8 py-16">
      <div class="">
        <Logo class="h-7 w-auto text-gray-900" />
        <h1 class="mt-6 text-xl font-semibold tracking-tight text-gray-900">This link is no longer valid</h1>
        <p class="mt-3 text-sm text-gray-600">
          The link you tried to open has expired. This usually happens when link was opened from your browser history or
          bookmarks
        </p>
        <p class="mt-3 text-sm text-gray-600">
          To continue, please return to the application you were using and start the process again
        </p>
        <p class="mt-3 text-sm text-gray-600">
          If the application you were using is unfamiliar or unexpected,
          <span class="font-bold text-gray-900">don't continue!</span>
          It's safest to close this page
        </p>
        <p class="mt-3 text-sm text-gray-900">
          <a href="#" class="text-blue-700 hover:text-blue-500 hover:underline">Learn how to secure your account</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
