{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!public/"]
    },
    "build": {
      "dependsOn": ["check", "^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "test": {},
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": false
  }
}